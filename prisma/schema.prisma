// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL") // uses connection pooling
}


model Client {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  cpfCnpj   String?
  phone     String?
  email     String?
  address            String?
  neighborhood       String?
  city               String?
  installationNumber String?
  cep                String?

  projects  Project[]

  @@index([name])
  @@index([cpfCnpj])
}

model Project {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  name         String?
  modulePower  Float
  totalKwp     Float
  totalModules Int
  
  // Equipamentos vinculados ao projeto
  moduleModel           String?
  inverterModel         String?
  
  // Dados Técnicos e Geração
  generationKwh         Float?
  reductionPercent      Float?
  moduleManufacturer    String?
  moduleArea            Float?
  moduleCurrent         Float?
  inverterManufacturer  String?
  inverterOutputPower   Float?
  inverterOutputCurrent Float?
  areaOccupied          Float?
  
  // Responsável Técnico
  professionalName      String?
  professionalCrt       String?

  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)

  units        ConsumerUnit[]

  @@index([clientId])
  @@index([createdAt])
}

model ConsumerUnit {
  id              String   @id @default(cuid())
  code            String
  name            String
  monthlyCons     Float
  dailyCons       Float
  requiredKwp     Float
  requiredModules Int

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
}
