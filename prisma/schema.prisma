// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL") // uses connection pooling
}

enum Role {
  ADMIN
  PARTNER
  TECHNICIAN
}

enum ProjectStatus {
  SIMULATION
  NEGOTIATION
  CLOSED
  INSTALLATION
  COMPLETED
  CANCELED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(PARTNER)
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  
  // Relacionamento Hierárquico: Parceiro > Técnico
  companyId     String?
  company       User?     @relation("PartnerTechnicians", fields: [companyId], references: [id])
  technicians   User[]    @relation("PartnerTechnicians")
  
  clients       Client[]
  auditLogs     AuditLog[]

  // White-Label / Branding (only for PARTNER role)
  brandColor    String?   // Hex color, ex: "#2563eb"
  logoUrl       String?   // URL or base64 of logo image
  companyPhone  String?   // Company contact phone
  companyWebsite String?  // Company website
}

model Client {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  name               String
  cpfCnpj            String?
  phone              String?
  email              String?
  address            String?
  neighborhood       String?
  city               String?
  installationNumber String?
  cep                String?

  userId             String?
  user               User?    @relation(fields: [userId], references: [id])

  projects           Project[]

  @@index([name])
  @@index([cpfCnpj])
}

model Project {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  status       ProjectStatus  @default(SIMULATION)
  name         String?
  modulePower  Float
  totalKwp     Float
  totalModules Int
  installationNumber String?
  
  // Equipamentos vinculados ao projeto
  moduleModel           String?
  inverterModel         String?
  
  // Dados Técnicos e Geração
  generationKwh         Float?
  reductionPercent      Float?
  moduleManufacturer    String?
  moduleArea            Float?
  moduleCurrent         Float?
  inverterManufacturer  String?
  inverterOutputPower   Float?
  inverterOutputCurrent Float?
  areaOccupied          Float?
  
  // Responsável Técnico
  professionalName      String?
  professionalCrt       String?

  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)

  units        ConsumerUnit[]
  inverters    ProjectInverter[]

  @@index([clientId])
  @@index([createdAt])
}

model ProjectInverter {
  id            String   @id @default(cuid())
  manufacturer  String?
  model         String?
  outputPower   Float?
  outputCurrent Float?
  quantity      Int      @default(1)
  
  // Novos campos para arranjo dos painéis
  numMppts      Int?     @default(1)
  inputsPerMppt Int?     @default(1)
  mpptInputs    String?  // Ex: "2,1" para MPPT1 com 2 entradas e MPPT2 com 1
  stringLayout  String?

  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}



model ConsumerUnit {
  id              String   @id @default(cuid())
  code            String
  name            String
  monthlyCons     Float
  dailyCons       Float
  requiredKwp     Float
  requiredModules Int

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String
  userId    String
  companyId String
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([companyId])
  @@index([userId])
}

model SolarModule {
  id           String   @id @default(cuid())
  manufacturer String
  model        String
  powerW       Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SolarInverter {
  id            String   @id @default(cuid())
  manufacturer  String
  model         String
  powerW        Float    // Nominal AC power
  numMppts      Int?     // Optional
  inputsPerMppt Int?     // Optional
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
