// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL") // uses connection pooling
}

enum Role {
  ADMIN
  PARTNER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(PARTNER)
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  clients       Client[]
}

model Client {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  name               String
  cpfCnpj            String?
  phone              String?
  email              String?
  address            String?
  neighborhood       String?
  city               String?
  installationNumber String?
  cep                String?

  userId             String?
  user               User?    @relation(fields: [userId], references: [id])

  projects           Project[]

  @@index([name])
  @@index([cpfCnpj])
}

model Project {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  name         String?
  modulePower  Float
  totalKwp     Float
  totalModules Int
  installationNumber String?
  
  // Equipamentos vinculados ao projeto
  moduleModel           String?
  inverterModel         String?
  
  // Dados Técnicos e Geração
  generationKwh         Float?
  reductionPercent      Float?
  moduleManufacturer    String?
  moduleArea            Float?
  moduleCurrent         Float?
  inverterManufacturer  String?
  inverterOutputPower   Float?
  inverterOutputCurrent Float?
  areaOccupied          Float?
  
  // Responsável Técnico
  professionalName      String?
  professionalCrt       String?

  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)

  units        ConsumerUnit[]
  inverters    ProjectInverter[]

  @@index([clientId])
  @@index([createdAt])
}

model ProjectInverter {
  id            String   @id @default(cuid())
  manufacturer  String?
  model         String?
  outputPower   Float?
  outputCurrent Float?
  quantity      Int      @default(1)
  
  // Novos campos para arranjo dos painéis
  numMppts      Int?     @default(1)
  inputsPerMppt Int?     @default(1)
  mpptInputs    String?  // Ex: "2,1" para MPPT1 com 2 entradas e MPPT2 com 1
  stringLayout  String?

  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}



model ConsumerUnit {
  id              String   @id @default(cuid())
  code            String
  name            String
  monthlyCons     Float
  dailyCons       Float
  requiredKwp     Float
  requiredModules Int

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
}
